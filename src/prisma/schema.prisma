model TimeLog {
  id                      String             @id @default(cuid())
  userId                  String
  timeIn                  DateTime           @db.Timestamptz(6)
  timeOut                 DateTime?          @db.Timestamptz(6)
  coffeeBreaks            Json?
  lunchBreak              Json?
  deviceInfo              Json?
  location                Json?
  status                  Boolean            @default(true)
  createdAt               DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  lateHours               Decimal?           @db.Decimal(5, 2)
  contestedPolicyApproved Boolean            @default(false)
  
  originalTimeIn          DateTime?          @db.Timestamptz(6)
  originalTimeOut         DateTime?          @db.Timestamptz(6)
  isApproved              Boolean            @default(false)
  punchType  PunchType  @default(REGULAR)
  remarks Json @default("[]")
  
  contests                ContestTimeLog[]
  overtime                Overtime[]
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdFromRequest      RequestedTimeLog[] @relation("CreatedFromRequest")
  approvals               TimeLogApproval[]

  autoClockOut    Boolean   @default(false)
  autoClockOutAt  DateTime?

  autoLunchDeductionMinutes Int?
  autoLunchApplied          Boolean  @default(false)
  autoCoffeeApplied         Boolean  @default(false)

  // ── Derived / computed fields (Phase 1 — eager compute at clock-out) ────────
  // All values are recomputed by computeTimeLogSummary() and must never be
  // manually set outside of that service. Raw timeIn/timeOut are the source
  // of truth and are never mutated after creation.
  undertimeHours        Decimal?  @db.Decimal(5, 2)  // hours short of scheduled shift end
  netWorkedHours        Decimal?  @db.Decimal(6, 2)  // REGULAR: gross-breaks | DA: sum of segment hours
  lunchDeductionMinutes Int?                          // final applied lunch deduction in minutes
  totalBreakMinutes     Int?                          // total coffee break time in minutes
  regularSegmentHours   Decimal?  @db.Decimal(6, 2)  // Regular shift hours (schedule-bounded); null for non-DA
  driverAmSegmentHours  Decimal?  @db.Decimal(6, 2)  // Driver AM segment hours; null for REGULAR / DRIVER_AIDE_PM
  driverPmSegmentHours  Decimal?  @db.Decimal(6, 2)  // Driver PM segment hours; null for REGULAR / DRIVER_AIDE_AM
  rawOtMinutes          Int?                          // OT minutes past Driver PM shift end; null for REGULAR
  scheduledHours        Decimal?  @db.Decimal(6, 2)  // sum of assigned shift durations; null when no shift assigned
  grossHours            Decimal?  @db.Decimal(6, 2)  // raw timeOut − timeIn in hours (before any deductions)
  calculatedAt          DateTime?  @db.Timestamptz(6) // when derived fields were last computed
  isTooEarlyPunch       Boolean    @default(false)    // true when clocked in beyond earlyClockInGraceMinutes before shift start
  // ─────────────────────────────────────────────────────────────────────────────

  liveUser              LiveUser?

  @@index([isApproved])
  @@index([timeIn, isApproved])
  @@index([userId, isApproved])
  @@index([userId, timeIn])
  @@index([userId, timeOut])
}

// ── Live clock-in presence table ─────────────────────────────────────────────
// One row per actively-clocked-in employee. Created at clock-in, removed at
// self clock-out. Auto-close (cron) deletes the row after closing the TimeLog.
// warnAt and closeAt are pre-computed at clock-in for fast indexed cron queries.
model LiveUser {
  id           String    @id @default(cuid())
  userId       String    @unique               // one active session per user
  companyId    String
  timeLogId    String    @unique               // the open TimeLog row
  scheduledEnd DateTime? @db.Timestamptz(6)   // resolved shift end (null = fallback used)
  warnAt       DateTime? @db.Timestamptz(6)   // scheduledEnd − autoClockOutWarningHours
  closeAt      DateTime? @db.Timestamptz(6)   // scheduledEnd + autoClockOutGraceHours
  warningSent  Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [userId],    references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timeLog TimeLog @relation(fields: [timeLogId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([warnAt])
  @@index([closeAt])
}

